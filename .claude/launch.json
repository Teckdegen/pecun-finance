{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pecun-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "pecun-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "pecun-docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "docs",
        "run",
        "dev"
      ],
      "port": 3002
    }
  ]
}
